{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "client/dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/tools",
      "destination": "/tools.html"
    },
    {
      "source": "/learning",
      "destination": "/learning.html"
    },
    {
      "source": "/learning/integration-development",
      "destination": "/learning/integration-development.html"
    },
    {
      "source": "/learning/roadmaps",
      "destination": "/learning/roadmaps.html"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/tools/xml-formatter",
      "destination": "/tools/xml-formatter.html"
    },
    {
      "source": "/tools/xml-validator",
      "destination": "/tools/xml-validator.html"
    },
    {
      "source": "/tools/xml-to-xsd",
      "destination": "/tools/xml-to-xsd.html"
    },
    {
      "source": "/tools/json-xml",
      "destination": "/tools/json-xml.html"
    },
    {
      "source": "/tools/xpath-tester",
      "destination": "/tools/xpath-tester.html"
    },
    {
      "source": "/tools/xslt-generator",
      "destination": "/tools/xslt-generator.html"
    },
    {
      "source": "/tools/groovy-tester",
      "destination": "/tools/groovy-tester.html"
    },
    {
      "source": "/tools/base64-codec",
      "destination": "/tools/base64-codec.html"
    },
    {
      "source": "/tools/jwt-decoder",
      "destination": "/tools/jwt-decoder.html"
    },
    {
      "source": "/tools/cpi-property-simulator",
      "destination": "/tools/cpi-property-simulator.html"
    },
    {
      "source": "/tools/url-codec",
      "destination": "/tools/url-codec.html"
    },
    {
      "source": "/tools/cron-parser",
      "destination": "/tools/cron-parser.html"
    },
    {
      "source": "/learning/btp-architecture",
      "destination": "/learning/btp-architecture.html"
    },
    {
      "source": "/learning/abap-development",
      "destination": "/learning/abap-development.html"
    },
    {
      "source": "/learning/fiori-ui5",
      "destination": "/learning/fiori-ui5.html"
    },
    {
      "source": "/learning/pipo-migration",
      "destination": "/learning/pipo-migration.html"
    },
    {
      "source": "/learning/sap-logistics-mm",
      "destination": "/learning/sap-logistics-mm.html"
    },
    {
      "source": "/learning/roadmaps/sap-integration-suite",
      "destination": "/learning/roadmaps/sap-integration-suite.html"
    },
    {
      "source": "/learning/roadmaps/sap-abap-developer",
      "destination": "/learning/roadmaps/sap-abap-developer.html"
    },
    {
      "source": "/learning/roadmaps/sap-btp-developer",
      "destination": "/learning/roadmaps/sap-btp-developer.html"
    },
    {
      "source": "/learning/roadmaps/sap-fiori-ui5",
      "destination": "/learning/roadmaps/sap-fiori-ui5.html"
    },
    {
      "source": "/learning/roadmaps/sap-mm-consultant",
      "destination": "/learning/roadmaps/sap-mm-consultant.html"
    },
    {
      "source": "/learning/roadmaps/sap-sd-consultant",
      "destination": "/learning/roadmaps/sap-sd-consultant.html"
    },
    {
      "source": "/learning/roadmaps/sap-fico-consultant",
      "destination": "/learning/roadmaps/sap-fico-consultant.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(favicon.*|ToolSap-Favicon.png|apple-touch-icon.png)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ]
}
